#!/usr/bin/env sh
set -e

echo "🚀 Pre-push validations..."

echo "📘 Type checking..."
pnpm run type-check

echo "🔍 ESLint..."
pnpm run lint

echo "🧪 Tests..."
pnpm test

echo "🔒 Security check..."
node scripts/security-check.cjs --quick

echo "📦 Build validation..."
node scripts/build-validations.cjs

echo "📦 Consumer package and integration examples..."
pnpm run build
pnpm run verify:package
pnpm run docs:verify

echo "✅ Pre-push validations passed."
