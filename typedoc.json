{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "out": "./docs/api-generated",
  "name": "@juspay/kriya",
  "readme": "none",
  "plugin": ["typedoc-plugin-markdown"],
  "theme": "default",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "excludeInternal": true,
  "excludeNotDocumented": false,
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": ["Core", "Services", "Commands", "Utilities", "Types", "*"],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "visibilityFilters": {
    "protected": true,
    "@alpha": false,
    "@beta": true,
    "@internal": false
  },
  "sort": ["source-order", "alphabetical"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "intentionallyNotExported": [
    "ACTION_TYPES",
    "TASK_HOST_OPERATIONS",
    "TASK_TARGET_OPERATIONS",
    "TASK_ROUTINE_EFFECTS",
    "TASK_COMMITMENT_EFFECTS",
    "TASK_COMMITMENT_CLASSES",
    "TASK_ARGUMENT_SLOTS",
    "TASK_ARGUMENT_SOURCES",
    "TASK_KEYS",
    "TASK_SCROLL_DIRECTIONS",
    "TASK_CHECKED_CHOICES",
    "TASK_COMPLETION_VERDICTS",
    "TASK_ANSWER_CHOICES",
    "TASK_ELEMENT_KINDS",
    "GUIDE_OPERATIONS",
    "GUIDE_ELEMENT_OPERATIONS"
  ],
  "treatWarningsAsErrors": true
}
