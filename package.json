{
  "name": "@juspay/kriya",
  "version": "2.2.0",
  "description": "Browser automation with typed task decisions, scoped execution, approvals and evidence-based completion. TypeScript, ESM, CommonJS and browser bundles.",
  "author": {
    "name": "Juspay Technologies",
    "email": "support@juspay.in",
    "url": "https://juspay.io"
  },
  "license": "MIT",
  "homepage": "https://juspay.github.io/kriya/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juspay/kriya.git"
  },
  "bugs": {
    "url": "https://github.com/juspay/kriya/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/juspay"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.cjs",
    "dist/index.esm.js",
    "dist/index.umd.js",
    "dist/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/**/*.md",
    "!docs/api-generated/**",
    "docs/examples/*.ts",
    "docs/examples/*.mjs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "automation",
    "web-automation",
    "browser-automation",
    "kriya",
    "form-filling",
    "form-automation",
    "dom-manipulation",
    "ai-actions",
    "ai-automation",
    "action-executor",
    "typescript",
    "esm",
    "cjs",
    "juspay",
    "task-agent",
    "human-in-the-loop",
    "typed-decisions"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "pnpm run build:watch",
    "clean": "node scripts/clean.mjs",
    "reset": "pnpm run clean && rm -rf node_modules && pnpm install --frozen-lockfile",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/format-staged.cjs",
    "audit": "pnpm audit --audit-level=high --prod",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "validate:env": "node scripts/env-validation.cjs",
    "validate:security": "node scripts/security-check.cjs",
    "validate:build": "node scripts/build-validations.cjs",
    "validate:commit": "node scripts/commit-validation.cjs",
    "validate:all": "pnpm run validate && pnpm run validate:env && pnpm run validate:security && pnpm run validate:build && pnpm test",
    "check:all": "pnpm run validate && pnpm run validate:commit && pnpm run audit",
    "quality:metrics": "node scripts/quality-metrics.cjs",
    "quality:report": "pnpm run quality:metrics && echo 'Quality metrics saved to quality-metrics.json'",
    "quality:all": "pnpm run lint && pnpm run format:check && pnpm run quality:metrics",
    "docs:build": "mkdocs build --strict --clean",
    "docs:serve": "mkdocs serve",
    "docs:gh-deploy": "mkdocs gh-deploy --force",
    "docs:api": "typedoc --treatWarningsAsErrors",
    "prepare": "husky",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run verify:package",
    "pre-push": "pnpm run validate:all",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test:semantic-release": "semantic-release --dry-run --no-ci",
    "verify:package": "node scripts/verify-package.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "test:tooling": "node --test scripts/check-staged.selftest.mjs scripts/npm-command.selftest.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "tests/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@istanbuljs/load-nyc-config>js-yaml": "^4.3.2"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
