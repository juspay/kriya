# pnpm configuration for @juspay/kriya. Settings here apply to this project only.

# Fail the install when the Node version does not satisfy the engines field.
engine-strict=true

# Save new dependencies with a caret range.
save-prefix=^
save-exact=false

# Resolve only package versions published at least 7 days ago (10080 minutes).
# Versions already pinned in pnpm-lock.yaml are unaffected, so frozen installs stay reproducible.
minimum-release-age=10080

# Default threshold for `pnpm audit`.
audit-level=moderate

# Registry network behaviour.
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
